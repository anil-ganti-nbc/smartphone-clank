[Unit]
Description=Schedule Smartphone Clank SOAK source samsung_us_owners_product (staging-labelled DB)

[Timer]
OnActiveSec=30s
OnUnitActiveSec=3h
AccuracySec=1s
Unit=smartphone-clank-soak@samsung_us_owners_product.service

# OPT-IN: no [Install] section, so this timer is NOT auto-enabled by
# timers.target. The operator enables it explicitly once the soak is approved
# and the staging DB/config exist. It never touches the production DB because
# the paired service forces CLANK_CONFIG=config/config.staging.yaml and
# --environment staging.
